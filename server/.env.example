# Copiar este archivo como .env y completar los valores.

PORT=3001

# Access token de Mercado Pago (Tus integraciones > Credenciales).
# Usar las credenciales de PRUEBA mientras se desarrolla.
MP_ACCESS_TOKEN=

# URL pública del servidor, para que Mercado Pago envíe las notificaciones de pago.
# En desarrollo, exponer el puerto con un túnel (p. ej. `ngrok http 3001`) y pegar acá la URL https.
PUBLIC_URL=

# URL donde corre el frontend (Mercado Pago vuelve acá después de pagar).
CLIENT_URL=http://localhost:5173

NOMBRE_TIENDA=Perfumes Marcia
# Número con código de país y sin "+", espacios ni guiones. Ej: 5491112345678
WHATSAPP_NUMBER=
# Usuario de Instagram sin "@"
INSTAGRAM_USER=

# Local físico (página "Nosotros"). Si DIRECCION queda vacía, no se muestra la ubicación.
# DIRECCION se usa también para el mapa de Google: poner calle, número y localidad.
DIRECCION=
# Ej: Lunes a viernes de 9 a 18 · Sábados de 9 a 13
HORARIOS=
# Opcional: referencias para llegar (colectivos, estación, entre calles...)
COMO_LLEGAR=

# Imágenes del carrusel de la portada (archivos en data/imagenes), separadas por coma y en orden
PORTADA_IMAGENES=1.jpg,2.jpg,4.jpg,5.jpg

# Carpeta donde están productos.xlsx y pedidos.xlsx (por defecto server/data)
# DATA_DIR=
